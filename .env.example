# Nombres de las variables (PLAN, sección 22). Los valores van solo en .env, nunca aquí.
ANTHROPIC_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_AUTH_TOKEN_LECTURA=
NVD_API_KEY=
CLAVE_ACCESO=
# Opcional: firma de los enlaces de /mi-equipo/ (si falta, se deriva de CLAVE_ACCESO)
RADAR_SECRETO_ENLACES=
CVE_UMBRAL_EPSS=0.10
CVE_UMBRAL_CVSS=9.0
CVE_UMBRAL_CVSS_SEMANAL=7.0
# Base sqlite local mientras no haya Turso (por defecto datos_locales/radar.db)
RADAR_SQLITE=
# Agente local (docs/agente-local.md). El token es opcional: sin él la inscripción está abierta
# y el filtro es el código de activación que se escribe en el panel.
AGENTE_TOKEN_INSCRIPCION=
AGENTE_INTERVALO_HORAS=12
# manual (por defecto): cada equipo nuevo espera aprobación en el panel. automatica: entra solo.
AGENTE_APROBACION=manual
# URL que va en el instalador descargado, si la de la petición no sirve (proxy).
RADAR_URL_PUBLICA=
