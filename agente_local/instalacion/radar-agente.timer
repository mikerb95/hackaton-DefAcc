# Cada 12 horas y poco despues de arrancar, con retraso aleatorio para que toda la flota
# no llegue al radar al mismo tiempo.
[Unit]
Description=Reporte periodico del agente local del radar

[Timer]
OnBootSec=5min
OnUnitActiveSec=12h
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
